# Create sync_status table
SYNC_STATUS=true

AUTOSYNC_ENABLED=false
AUTOSYNC_INTERVAL=100000

# START - Sync app
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SYNC_LOG_LEVEL=WARNING
CACHE_LOG_LEVEL=WARNING

# The port to run the Django server on.
SYNC_PORT=8000

# END - Sync app

# The in-network port of the Postgres database.
# CI connects in-network (compose service 'database'), not host-published;
# the host-publish port lives in docker/.env as DATABASE_PORT=5433.
DATABASE_PORT=5432

# Postgres password. You should change it to a random password.
# Please only use alphanumerical (a-Z, 0-9) characters; no special characters, no spaces.
DATABASE_PASSWORD=password

# The values below this line do not need to be changed.
###################################################################################
SYNC_HOST=sync
DATABASE_HOST=database
DATABASE_USERNAME=postgres
USER_ID=25232